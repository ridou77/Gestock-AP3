rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isActiveUser() {
      return isSignedIn() &&
        userDoc(request.auth.uid) != null &&
        userDoc(request.auth.uid).active != false;
    }

    function hasRole(role) {
      return isActiveUser() && userDoc(request.auth.uid).role == role;
    }

    function isAdmin() {
      return hasRole("admin");
    }

    function isGestionnaire() {
      return hasRole("gestionnaire");
    }

    function isVisiteur() {
      return hasRole("visiteur");
    }

    function isAdminOrGestionnaire() {
      return isAdmin() || isGestionnaire();
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSelfProfileUpdate(userId) {
      return isSelf(userId) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.active == resource.data.active &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.firstName is string &&
        request.resource.data.lastName is string &&
        (request.resource.data.age is int || request.resource.data.age == null) &&
        request.resource.data.updatedAt is timestamp;
    }

    function isAdminUserUpdate() {
      return request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.role in ["admin", "gestionnaire", "visiteur"] &&
        request.resource.data.active is bool &&
        request.resource.data.firstName is string &&
        request.resource.data.lastName is string &&
        (request.resource.data.age is int || request.resource.data.age == null) &&
        request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.email is string &&
        request.resource.data.role == "visiteur" &&
        request.resource.data.firstName is string &&
        request.resource.data.lastName is string &&
        (request.resource.data.age is int || request.resource.data.age == null) &&
        request.resource.data.active == true &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp;

      allow update: if (isAdmin() && isAdminUserUpdate()) || isSelfProfileUpdate(userId);

      allow delete: if isAdmin();
    }

    match /typeStock/{typeId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdminOrGestionnaire();
    }

    match /produits/{productId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdminOrGestionnaire();
    }

    match /commandes/{orderId} {
      allow read: if isActiveUser() &&
        (isAdminOrGestionnaire() || request.auth.uid == resource.data.utilisateur);

      allow create: if isAdminOrGestionnaire() &&
        request.auth.uid == request.resource.data.utilisateur &&
        request.resource.data.utilisateurEmail is string &&
        request.resource.data.statut == "En attente" &&
        request.resource.data.details is list &&
        request.resource.data.stockProcessed == false;

      allow update: if isAdminOrGestionnaire() || (
        isActiveUser() &&
        request.auth.uid == resource.data.utilisateur &&
        !isVisiteur() &&
        (
          (
            resource.data.statut == "En attente" &&
            request.resource.data.statut == "En attente" &&
            request.resource.data.details is list &&
            request.resource.data.utilisateur == resource.data.utilisateur &&
            request.resource.data.utilisateurEmail == resource.data.utilisateurEmail &&
            request.resource.data.dateCommande == resource.data.dateCommande &&
            request.resource.data.stockProcessed == resource.data.stockProcessed
          ) ||
          (
            request.resource.data.statut == "Annulée" &&
            resource.data.statut in ["En attente", "En préparation", "Expédiée"] &&
            request.resource.data.details == resource.data.details &&
            request.resource.data.utilisateur == resource.data.utilisateur &&
            request.resource.data.utilisateurEmail == resource.data.utilisateurEmail &&
            request.resource.data.dateCommande == resource.data.dateCommande &&
            request.resource.data.stockProcessed == resource.data.stockProcessed
          )
        )
      );

      allow delete: if isAdminOrGestionnaire() ||
        (isActiveUser() && request.auth.uid == resource.data.utilisateur && !isVisiteur() && resource.data.statut == "En attente");
    }

    match /mouvements/{movementId} {
      allow read: if isAdminOrGestionnaire();
      allow create: if isAdminOrGestionnaire();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
